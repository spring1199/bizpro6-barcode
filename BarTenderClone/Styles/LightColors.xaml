<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Primary Colors (Refined Indigo/Blue) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3730A3"/>
    
    <!-- Neutral Colors (Light Slate Slate) -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextOnSelectedBrush" Color="#0F172A"/>
    
    <!-- Semantic Colors -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>
    
    <!-- DataGrid Colors -->
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ZebraStripeBrush" Color="#F8FAFC"/>

    <!-- Premium UI Colors -->
    <SolidColorBrush x:Key="SelectionGlowBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="HandleBorderBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="HandleFillBrush" Color="#FFFFFF"/>
    
    <!-- Sidebar Colors -->
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#EEF2F6"/>
    <SolidColorBrush x:Key="SidebarSelectedTextBrush" Color="#4F46E5"/>
</ResourceDictionary>
